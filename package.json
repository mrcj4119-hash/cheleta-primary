{
  "name": "cheleta-primary-school-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "frontend": "vite --host 0.0.0.0 --port 4321",
    "server": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4321",
    "test": "node --test tests/app.test.js",
    "test:load": "node tests/load.test.js",
    "migrate": "node --env-file-if-exists=.env migrate.js",
    "seed": "node --env-file-if-exists=.env migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.10"
  }
}
